# Copie para .env (o .env nunca deve ser commitado).
# Sem token (ou USE_IA=False) o guardião roda 100% determinístico: mesmas retenções,
# explicações do cache ou do texto-modelo.

# --- Gateway de IA do evento (AI Proxy, formato OpenAI)
AI_PROXY_API_KEY=
USE_IA=False
AI_MODEL=latest
# AI_PROXY_BASE_URL=https://ai-proxy.gogroupbr.com/v1
# AI_TIMEOUT_S=30
# AI_MAX_RETRIES=1
# AI_MAX_TOKENS=2000
# JEV_LIMIAR_AGRAVAR=0.7
# CB_FAILURE_THRESHOLD=3
# CB_RESET_S=60
# CACHE_DIR=cache_explicacoes

# --- Guardião
DADOS_DIR=pagamentos
AGORA=2026-11-02T08:00
DIAS_LANCADOR_RECENTE=45
EXECUTOR=agenda_simulada
AUDIT_DB=data/audit.db
APP_TIMEZONE=America/Sao_Paulo

# --- Slack (Socket Mode; item 6 do SPEC). Sem os três, o bot manda tudo para a fila manual.
# SLACK_BOT_TOKEN=xoxb-...      (OAuth & Permissions > Bot User OAuth Token)
# SLACK_APP_TOKEN=xapp-...      (Basic Information > App-Level Tokens, escopo connections:write)
# SLACK_CANAL=C0123456789       (ID do canal: botão direito no canal > Ver detalhes do canal)
